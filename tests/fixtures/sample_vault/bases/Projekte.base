formulas:
  BudgetLabel: '"Budget: " + Budget.toString()'
  Jahr: Beginn.year
filters:
  and:
    - file.inFolder("data/Projekte")
views:
  - name: Projekte
    type: table
    order:
      - file.name
      - Titel
      - Beginn
      - formula.Jahr
      - BudgetLabel
    filters:
      and:
        - file.inFolder("data/Projekte")
